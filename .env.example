# Core database settings. deploy/install.sh generates a random password.
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=replace-with-a-random-secret

# local starts the bundled PostgreSQL service; external uses the URL in the Secret file.
RELAY_DATABASE_MODE=local
RELAY_DATABASE_URL_SECRET_FILE=./deploy/secrets/database-url
# The installer writes the actual URL to the file above. Do not add RELAY_DATABASE_URL here.

# Local bind and image. The public Caddy profile still keeps this port on loopback.
RELAY_PORT=7777
RELAY_IMAGE=relay:local

# Set by: ./deploy/install.sh --hosted flow.example.com
RELAY_DOMAIN=

# Feishu sign-in. The app must be the same one GitLab uses for oauth2_generic so that
# open_id matches on both sides. ALLOWED_TENANT_KEYS is mandatory: without it, any Feishu
# user from any company could complete the OAuth flow.
# RELAY_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# RELAY_FEISHU_APP_SECRET=replace-me
# RELAY_FEISHU_REDIRECT_URL=https://relay.example.com/auth/feishu/callback
# RELAY_FEISHU_ALLOWED_TENANT_KEYS=replace-with-your-tenant-key

# Append only the integrations you enable. Never commit the resulting .env.
# RELAY_OIDC_ISSUER=https://id.example.com
# RELAY_OIDC_CLIENT_ID=relay
# RELAY_OIDC_CLIENT_SECRET=replace-me
# RELAY_OIDC_REDIRECT_URL=https://flow.example.com/auth/oidc/callback
# RELAY_SCIM_BEARER_TOKEN=replace-with-at-least-32-characters
# RELAY_GITLAB_WRITE_TOKEN=replace-me
# RELAY_MICROSOFT_GRAPH_TOKEN=replace-me
# RELAY_GOOGLE_WORKSPACE_TOKEN=replace-me
