# CI 构建镜像：先跑格式、Clippy 和全部测试，通过后才产出运行时镜像。
#
# 基础镜像一律用内部 registry（infra/images 约定），不直连 DockerHub。
# 这两个镜像同步时已经把 apt 源改成 mirrors.aliyun.com，所以下面不需要再动 sources。
#
# 检查放在构建阶段而不是独立 job：集群 runner 侧没有带 clippy/rustfmt 的 rust 镜像，
# 放这里能顺带复用 buildkit 的层缓存。检查不过镜像就构建不出来。
#
# 测试不依赖 Docker daemon，也不依赖外部 PostgreSQL：
# tests/postgres_data_plane.rs 在 RELAY_TEST_DATABASE_URL 未设置时自动跳过。

# 用 1.96 而不是仓库里更早的 1.87：ratatui 0.30 和 darling 0.23 的 MSRV 是 1.88。
FROM registry.edumind.ai/infra/images/rust:1.96-bookworm AS builder

# 基础镜像配了 apt 源，但没配 cargo 源，直连 crates.io 会卡死：
# 上一次构建 cargo fmt 空转 23 分钟没有任何输出，全花在下载索引和 crate 上。
# 这块值得后面挪进 infra/images 的 rust 定制里（就像 golang 镜像里的 GOPROXY）。
ARG CARGO_MIRROR=sparse+https://mirrors.aliyun.com/crates.io-index/
RUN mkdir -p "$CARGO_HOME" && printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "mirror"' \
        '[source.mirror]' \
        "registry = \"${CARGO_MIRROR}\"" \
        > "$CARGO_HOME/config.toml"

# 官方 rust 镜像用 --profile minimal 装工具链，不带 clippy 和 rustfmt。
RUN rustup component add rustfmt clippy

WORKDIR /build
# 注意这里**不复制** rust-toolchain.toml：它写的是 channel = "stable"，
# 而镜像里装的工具链名叫 1.87.0，rustup 会为了满足 "stable" 去下载一整套。
# CI 直接用镜像钉住的 1.87.0，比跟着 stable 漂移更可复现。
COPY Cargo.toml Cargo.lock README.md LICENSE ./
# 依赖下载单独一层：只依赖 Cargo.lock，改源码不会让它失效。
RUN cargo fetch --locked

COPY src ./src
COPY tests ./tests

# 分成独立 RUN，失败时能直接看出是哪一步挂的，缓存粒度也更细。
RUN cargo fmt --all -- --check
RUN cargo clippy --all-targets --all-features --locked --offline -- -D warnings
RUN cargo test --all-targets --locked --offline
RUN cargo build --release --locked --offline

FROM registry.edumind.ai/infra/images/debian:bookworm-slim

ARG OCI_REVISION=unknown
ARG OCI_SOURCE=unknown
LABEL org.opencontainers.image.revision=$OCI_REVISION
LABEL org.opencontainers.image.source=$OCI_SOURCE

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home relay \
    && install -d -m 0700 -o relay -g relay /var/lib/relay

COPY --from=builder /build/target/release/relay /usr/local/bin/relay

USER relay
VOLUME ["/var/lib/relay"]
EXPOSE 7777
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:7777/health/ready > /dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/relay", "--data-dir", "/var/lib/relay"]
CMD ["serve", "--bind", "0.0.0.0:7777", "--allow-insecure-public-http"]
